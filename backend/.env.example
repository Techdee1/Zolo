# Zolo environment. Copy to .env (gitignored). Secrets live in the environment only, never in code.

# --- required ---
DATABASE_URL=postgresql+asyncpg://zolo:zolo@localhost:5432/zolo
SESSION_SECRET=            # at least 32 random characters (openssl rand -hex 32)

# --- passkeys (RP_ID must be the registrable domain the phone's passkey is bound to) ---
RP_ID=localhost
RP_NAME=Zolo
ORIGIN=http://localhost:3000          # exact browser origin(s), comma separated
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=true                    # false only for plain-http localhost

# --- general ---
ENV=dev                               # dev | test | prod
LOG_LEVEL=INFO
REQUEST_TTL_SECONDS=120
SESSION_TTL_SECONDS=43200
MOCK_OTP=123456                       # the fixed OTP for mock login (Phases 1 and 2)

# --- risk (kobo): 100,000 and 200,000 naira ---
PER_PAYMENT_CAP_KOBO=10000000
DAILY_CAP_KOBO=20000000
RISK_TIMEZONE=Africa/Lagos

# --- rate limits ---
CLAIM_ATTEMPTS_PER_MINUTE=5
CLAIM_LOCK_WRONG_TRIES=5
CLAIM_LOCK_SECONDS=300
APPROVE_ATTEMPTS_PER_MINUTE=10
LOGIN_ATTEMPTS_PER_MINUTE=10

# --- demo console (exists only when DEMO_MODE=true and the token is sent) ---
DEMO_MODE=false
DEMO_TOKEN=

# --- Phase 2 and 3 flags: all off by default ---
FEATURE_SSE=false
FEATURE_RENEW=false
FEATURE_VOICE=false
FEATURE_CARD_GUARD=false
FEATURE_FAILURE_INJECTION=false
FEATURE_PHONE_CALL=false

# --- AI package (zolo.ai) ---
SPITCH_API_KEY=
YARNGPT_API_KEY=
STT_LIVE_ENABLED=false     # true only in the demo environment; protects Spitch credits
STT_PROVIDER=spitch
TTS_LIVE_ENABLED=false
AI_AGENT_ENABLED=false     # Phase 2, not built yet
ALLOW_TEXT_INPUT=false     # dev only: voice_turn accepts typed text instead of audio
AUDIO_CACHE_DIR=var/audio
STT_CALL_COUNT_FILE=var/stt_calls.json
# TTS provider and voice per language, no code change needed to switch:
TTS_PROVIDER_EN=yarngpt
TTS_PROVIDER_PCM=yarngpt
TTS_PROVIDER_YO=yarngpt
TTS_PROVIDER_HA=yarngpt
TTS_PROVIDER_IG=yarngpt
# TTS_VOICE_PCM=idera
