# Zolo environment. Copy to .env (gitignored). Secrets live in the environment only, never in code.

# --- required ---
DATABASE_URL=postgresql+asyncpg://zolo:zolo@localhost:5432/zolo
SESSION_SECRET=            # at least 32 random characters (openssl rand -hex 32)

# --- passkeys (RP_ID must be the registrable domain the phone's passkey is bound to) ---
RP_ID=localhost
RP_NAME=Zolo
ORIGIN=http://localhost:3000          # exact browser origin(s), comma separated
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=true                    # false only for plain-http localhost
TRUST_FORWARDED_FOR=false             # true behind a proxy/tunnel so rate limits use the real client IP

# --- general ---
ENV=dev                               # dev | test | prod
LOG_LEVEL=INFO
REQUEST_TTL_SECONDS=120
SESSION_TTL_SECONDS=43200
MOCK_OTP=123456                       # the fixed OTP for mock login (Phases 1 and 2)

# --- mock bank (300-800 ms latency by default; 0 for tests) ---
MOCK_BANK_CODE=057
MOCK_BANK_LATENCY_MIN_MS=300
MOCK_BANK_LATENCY_MAX_MS=800

# --- passkey signature counter ---
# true (default, production): the counter must strictly increase once non-zero.
# false (demo only): an equal non-zero counter is allowed and logged as a warning. A counter that
# goes backwards is refused in both modes.
WEBAUTHN_STRICT_COUNTER=true

# --- risk (kobo): 100,000 and 200,000 naira ---
PER_PAYMENT_CAP_KOBO=10000000
DAILY_CAP_KOBO=20000000
RISK_TIMEZONE=Africa/Lagos

# --- rate limits ---
CLAIM_ATTEMPTS_PER_MINUTE=5
CLAIM_LOCK_WRONG_TRIES=5
CLAIM_LOCK_SECONDS=300
APPROVE_ATTEMPTS_PER_MINUTE=10
LOGIN_ATTEMPTS_PER_MINUTE=10
CHALLENGE_ATTEMPTS_PER_MINUTE=10
CREATE_REQUESTS_PER_MINUTE=10

# --- demo console (exists only when DEMO_MODE=true and the token is sent) ---
# DEMO_MODE=true turns on mock login and the test page; it needs a DEMO_TOKEN of 8+ characters.
DEMO_MODE=false
DEMO_TOKEN=

# --- Phase 2 and 3 flags: all off by default ---
FEATURE_SSE=false
FEATURE_RENEW=false
FEATURE_VOICE=false
FEATURE_CARD_GUARD=false
FEATURE_FAILURE_INJECTION=false
FEATURE_PHONE_CALL=false
# Phone-call approval (only used when the flag above is true): cap per payment on this channel,
# wrong-PIN lockout, cooling-off after a number change, calls an hour.
# CALL_CHANNEL_CAP_KOBO=2000000
# PHONE_LOCK_WRONG_TRIES=3
# PHONE_LOCK_SECONDS=1800
# PHONE_COOLING_OFF_HOURS=24
# PHONE_CALLS_PER_HOUR=3

# --- AI package (zolo.ai) ---
SPITCH_API_KEY=
YARNGPT_API_KEY=
STT_LIVE_ENABLED=false     # true only in the demo environment; protects Spitch credits
STT_PROVIDER=spitch
TTS_LIVE_ENABLED=false
AI_AGENT_ENABLED=false     # Phase 2, not built yet
ALLOW_TEXT_INPUT=false     # dev only: voice_turn accepts typed text instead of audio
AUDIO_CACHE_DIR=var/audio
AUDIO_PRERENDER_ON_CREATE=false  # true: render the English and Pidgin readback when an agent creates a request (spends TTS credits)
AUDIO_WAIT_SECONDS=4             # how long a readback waits for a clip still being rendered
AUDIO_PRERENDER_ON_CREATE=false   # true: render the English and Pidgin readback in the background when an agent creates a request (spends TTS credits)
AUDIO_WAIT_SECONDS=4              # how long a readback waits for a clip that is still being rendered
STT_CALL_COUNT_FILE=var/stt_calls.json
# TTS provider and voice per language, no code change needed to switch:
TTS_PROVIDER_EN=yarngpt
TTS_PROVIDER_PCM=yarngpt
TTS_PROVIDER_YO=yarngpt
TTS_PROVIDER_HA=yarngpt
TTS_PROVIDER_IG=yarngpt
# TTS_VOICE_PCM=idera
