# Copy to deploy/.env and fill in. Never commit deploy/.env.

# ── The address people open. Passkeys are bound to this host, so choose it once. ──────────────
# With a real domain whose DNS A record points at this machine, Caddy gets the HTTPS certificate:
SITE_ADDRESS=zolo.example.com
SITE_HOST=zolo.example.com
SITE_ORIGIN=https://zolo.example.com
# For a local check on plain HTTP instead (no passkeys on a phone, but everything else works):
# SITE_ADDRESS=http://localhost
# SITE_HOST=localhost
# SITE_ORIGIN=http://localhost
# COOKIE_SECURE=false

# ── Secrets (generate with: openssl rand -hex 32) ────────────────────────────────────────────
POSTGRES_PASSWORD=
SESSION_SECRET=
DEMO_TOKEN=

# ── Readback voice (YarnGPT). Without a key the app still works: the screen reader reads it. ──
YARNGPT_API_KEY=
AUDIO_PRERENDER_ON_CREATE=true
TTS_VOICE_EN=idera
TTS_VOICE_PCM=idera

# ── Shown on the landing page (optional) ──────────────────────────────────────────────────────
TEAM_NAME=
REPO_URL=
DEMO_VIDEO_URL=
