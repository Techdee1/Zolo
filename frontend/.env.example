# --- Server-side only (never sent to the browser) ---------------------------------------------
# Where the Zolo API lives. The browser only talks to this app; /api/* is proxied here, so the
# session cookie is first-party and there is no CORS. Read at RUNTIME (change it without a rebuild).
BACKEND_URL=http://localhost:8000

# Set to 1 in real https deployments so stray http sub-resources are upgraded by the CSP.
CSP_UPGRADE_INSECURE=

# --- Public, build-time flags (NEXT_PUBLIC_* are visible in the browser: never a secret) --------
NEXT_PUBLIC_FEATURE_DEMO=false  # the /demo console for the stage demo (on for e2e builds)
NEXT_PUBLIC_FEATURE_CARD_GUARD=false    # Card Guard (Phase 3 on the backend; not built yet)
NEXT_PUBLIC_FEATURE_KITCHEN_SINK=false  # the /kitchen-sink component gallery (on for e2e builds)
NEXT_PUBLIC_USE_MOCKS=false             # run on mock data (MSW) instead of the API
